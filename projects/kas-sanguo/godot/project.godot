; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can modify it manually.

[application]

config/name="KAS 三國"
config/description="三國策略遊戲 MVP - 基於 Kaspa 區塊鏈"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Web")
boot_splash/bg_color=Color(0.101961, 0.101961, 0.180392, 1)
config/icon="res://icon.png"

[display]

window/size/viewport_width=375
window/size/viewport_height=812
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="compatibility"
renderer/rendering_method.web="compatibility"
textures/canvas_textures/default_texture_filter=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="UI"
2d_physics/layer_2="Cities"
2d_physics/layer_3="Army"

[autoload]

GameManager="*res://scripts/GameManager.gd"